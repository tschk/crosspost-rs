# Server Configuration
SERVER__HOST=127.0.0.1
SERVER__PORT=3000
SERVER__BASE_URL=http://localhost:3000

# Database Configuration
DATABASE__SURREALDB_URL=memory://
DATABASE__ROCKSDB_PATH=./data/rocksdb

# Twitter OAuth Configuration
OAUTH__TWITTER__CLIENT_ID=your_twitter_client_id
OAUTH__TWITTER__CLIENT_SECRET=your_twitter_client_secret
OAUTH__TWITTER__REDIRECT_URI=http://localhost:3000/auth/twitter/callback

# Facebook OAuth Configuration
OAUTH__FACEBOOK__CLIENT_ID=your_facebook_client_id
OAUTH__FACEBOOK__CLIENT_SECRET=your_facebook_client_secret
OAUTH__FACEBOOK__REDIRECT_URI=http://localhost:3000/auth/facebook/callback

# Instagram OAuth Configuration
OAUTH__INSTAGRAM__CLIENT_ID=your_instagram_client_id
OAUTH__INSTAGRAM__CLIENT_SECRET=your_instagram_client_secret
OAUTH__INSTAGRAM__REDIRECT_URI=http://localhost:3000/auth/instagram/callback

# LinkedIn OAuth Configuration
OAUTH__LINKEDIN__CLIENT_ID=your_linkedin_client_id
OAUTH__LINKEDIN__CLIENT_SECRET=your_linkedin_client_secret
OAUTH__LINKEDIN__REDIRECT_URI=http://localhost:3000/auth/linkedin/callback

# YouTube OAuth Configuration
OAUTH__YOUTUBE__CLIENT_ID=your_youtube_client_id
OAUTH__YOUTUBE__CLIENT_SECRET=your_youtube_client_secret
OAUTH__YOUTUBE__REDIRECT_URI=http://localhost:3000/auth/youtube/callback

# TikTok OAuth Configuration
OAUTH__TIKTOK__CLIENT_ID=your_tiktok_client_id
OAUTH__TIKTOK__CLIENT_SECRET=your_tiktok_client_secret
OAUTH__TIKTOK__REDIRECT_URI=http://localhost:3000/auth/tiktok/callback

# Reddit OAuth Configuration
OAUTH__REDDIT__CLIENT_ID=your_reddit_client_id
OAUTH__REDDIT__CLIENT_SECRET=your_reddit_client_secret
OAUTH__REDDIT__REDIRECT_URI=http://localhost:3000/auth/reddit/callback

# Twitch OAuth Configuration
OAUTH__TWITCH__CLIENT_ID=your_twitch_client_id
OAUTH__TWITCH__CLIENT_SECRET=your_twitch_client_secret
OAUTH__TWITCH__REDIRECT_URI=http://localhost:3000/auth/twitch/callback

# Slack OAuth Configuration
OAUTH__SLACK__CLIENT_ID=your_slack_client_id
OAUTH__SLACK__CLIENT_SECRET=your_slack_client_secret
OAUTH__SLACK__REDIRECT_URI=http://localhost:3000/auth/slack/callback

# Telegram Configuration (uses Bot API, not OAuth)
OAUTH__TELEGRAM__CLIENT_ID=your_telegram_bot_token
OAUTH__TELEGRAM__CLIENT_SECRET=not_used
OAUTH__TELEGRAM__REDIRECT_URI=not_used
