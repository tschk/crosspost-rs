# Crosspost Library Configuration
# Set to "1" to load .env file from current directory, or provide a path
CROSSPOST_DOTENV=1

# --- Platform Credentials ---

# Twitter / X
# Access Token (OAuth2 Bearer Token)
TWITTER_ACCESS_TOKEN=your_twitter_bearer_token
# Alternate env var name supported:
# TWITTER_ACCESS_TOKEN_KEY=your_twitter_bearer_token

# Bluesky
BLUESKY_IDENTIFIER=user.bsky.social
BLUESKY_PASSWORD=your-app-password
# Optional: defaults to bsky.social
# BLUESKY_HOST=bsky.social

# Mastodon
MASTODON_ACCESS_TOKEN=your_mastodon_access_token
# Optional: defaults to mastodon.social
# MASTODON_HOST=mastodon.social

# LinkedIn
LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token

# Facebook (Graph API)
FACEBOOK_ACCESS_TOKEN=your_facebook_page_access_token

# Instagram (Graph API)
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token

# Discord (Bot)
DISCORD_BOT_TOKEN=your_discord_bot_token
DISCORD_CHANNEL_ID=your_discord_channel_id

# Discord (Webhook)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Telegram (Bot API)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Slack
SLACK_TOKEN=xoxb-your-slack-bot-token
# Optional: defaults to #general
# SLACK_CHANNEL=#general

# Dev.to
DEVTO_API_KEY=your_devto_api_key

# Nostr
# Private key in hex or bech32 (nsec1...) format
NOSTR_PRIVATE_KEY=your_nostr_private_key
# Comma-separated list of relays
NOSTR_RELAYS=wss://relay.damus.io,wss://nos.lol

# YouTube (Data API)
YOUTUBE_ACCESS_TOKEN=your_youtube_access_token

# TikTok (Content Posting API)
TIKTOK_ACCESS_TOKEN=your_tiktok_access_token

# Reddit
REDDIT_ACCESS_TOKEN=your_reddit_access_token
# Optional: defaults to user profile
# REDDIT_SUBREDDIT=rust

# Twitch (Chat Announcements)
TWITCH_ACCESS_TOKEN=your_twitch_access_token
TWITCH_CLIENT_ID=your_twitch_client_id

# ------------------------------------------------------------------
# Server Configuration (Optional - only for SaaS server crates)
# ------------------------------------------------------------------

SERVER__HOST=127.0.0.1
SERVER__PORT=3000
SERVER__BASE_URL=http://localhost:3000

# Auth Configuration
AUTH__JWT_SECRET=change-this-to-a-long-random-secret-in-production
AUTH__TOKEN_EXPIRY_SECS=3600

# Database Configuration
DATABASE__SURREALDB_URL=memory://
DATABASE__ROCKSDB_PATH=./data/rocksdb

# SaaS OAuth Configuration (for managing user flows)
OAUTH__TWITTER__CLIENT_ID=your_twitter_client_id
OAUTH__TWITTER__CLIENT_SECRET=your_twitter_client_secret
OAUTH__TWITTER__REDIRECT_URI=http://localhost:3000/auth/twitter/callback

OAUTH__FACEBOOK__CLIENT_ID=your_facebook_client_id
OAUTH__FACEBOOK__CLIENT_SECRET=your_facebook_client_secret
OAUTH__FACEBOOK__REDIRECT_URI=http://localhost:3000/auth/facebook/callback

OAUTH__INSTAGRAM__CLIENT_ID=your_instagram_client_id
OAUTH__INSTAGRAM__CLIENT_SECRET=your_instagram_client_secret
OAUTH__INSTAGRAM__REDIRECT_URI=http://localhost:3000/auth/instagram/callback

OAUTH__LINKEDIN__CLIENT_ID=your_linkedin_client_id
OAUTH__LINKEDIN__CLIENT_SECRET=your_linkedin_client_secret
OAUTH__LINKEDIN__REDIRECT_URI=http://localhost:3000/auth/linkedin/callback

OAUTH__YOUTUBE__CLIENT_ID=your_youtube_client_id
OAUTH__YOUTUBE__CLIENT_SECRET=your_youtube_client_secret
OAUTH__YOUTUBE__REDIRECT_URI=http://localhost:3000/auth/youtube/callback

OAUTH__TIKTOK__CLIENT_ID=your_tiktok_client_id
OAUTH__TIKTOK__CLIENT_SECRET=your_tiktok_client_secret
OAUTH__TIKTOK__REDIRECT_URI=http://localhost:3000/auth/tiktok/callback

OAUTH__REDDIT__CLIENT_ID=your_reddit_client_id
OAUTH__REDDIT__CLIENT_SECRET=your_reddit_client_secret
OAUTH__REDDIT__REDIRECT_URI=http://localhost:3000/auth/reddit/callback

OAUTH__TWITCH__CLIENT_ID=your_twitch_client_id
OAUTH__TWITCH__CLIENT_SECRET=your_twitch_client_secret
OAUTH__TWITCH__REDIRECT_URI=http://localhost:3000/auth/twitch/callback

OAUTH__SLACK__CLIENT_ID=your_slack_client_id
OAUTH__SLACK__CLIENT_SECRET=your_slack_client_secret
OAUTH__SLACK__REDIRECT_URI=http://localhost:3000/auth/slack/callback
